{
  // Format the code when saving files
  "editor.formatOnSave": true,

  // Enable organizing imports (sort imports and remove unused ones)
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // Set maximum line length for word wrapping
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 140,

  "java.format.enabled": true,
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },

  // Use a specific Java formatter
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "java.format.settings.profile": "GoogleStyle", // Change to your preferred profile

  //Remove extra spaces/tabs at the end of lines
  "files.trimTrailingWhitespace": true,

  //Remove more than one extra new line at the end of files
  "files.trimFinalNewlines": true,
}
